<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- Metadaten & Publisher-Informationen -->
    <AssemblyName>SystemOptimierer</AssemblyName>
    <RootNamespace>SystemOptimierer</RootNamespace>
    <Version>2.5.0</Version>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <FileVersion>2.5.0.0</FileVersion>
    <Company>SystemOptimizer PRO</Company>
    <Product>SystemOptimizer PRO</Product>
    <Description>Windows System-Optimierungs- und Wartungstool</Description>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>de-DE</NeutralLanguage>

    <!-- Qualitätssicherung: empfohlene .NET-Analyzer, reproduzierbare Builds -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Release ohne separate PDB-Datei: kleinere Auslieferung, trotzdem vollständige Stacktraces -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <!-- Archivierte Alt-Dateien vom Build ausschließen -->
  <ItemGroup>
    <Compile Remove="_archive_alte_dateien\**" />
    <None Remove="_archive_alte_dateien\**" />
    <Content Remove="_archive_alte_dateien\**" />
    <EmbeddedResource Remove="_archive_alte_dateien\**" />
    <Page Remove="_archive_alte_dateien\**" />
  </ItemGroup>

  <!-- Vollautomatische Authenticode-Signierung nach jedem erfolgreichen Build -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)scripts\sign-binaries.ps1&quot; &quot;$(TargetDir.TrimEnd('\'))&quot;" />
  </Target>

</Project>
